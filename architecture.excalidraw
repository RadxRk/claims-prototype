      "type": "text", "id": "evidence_code", "x": 936, "y": 510, "width": 388, "height": 350,
      "text": "event: status\ndata: {\"message\":\"Preprocessing image\"}\n\nevent: status\ndata: {\"message\":\"Uploading to Files API\"}\n\nevent: status\ndata: {\"message\":\"Identifying vehicle...\"}\n\nevent: status\ndata: {\"message\":\"Generating output\"}\n\nevent: complete\ndata: {\n  \"analysis\": {\n    \"car\": { \"make\":\"Honda\", ... },\n    \"damage\": { \"severity\":\"moderate\" },\n    \"repair_estimate\":\n      { \"low_usd\":1200, \"high_usd\":2800 }\n  },\n  \"triggers\": [\n    { \"code\":\"high_value\",\n      \"value\":11200, \"threshold\":9000 }\n  ],\n  \"meta\": { \"model\":\"claude-sonnet-4-6\",\n            \"file_id\":\"file_011CN…\" }\n}",
